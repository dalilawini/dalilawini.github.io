# Angular SPA routing: send all non-file requests to index.html
AddType application/javascript .mjs
AddType application/octet-stream .bin
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Firmware/data files must 404 when missing, never fall back to index.html
  RewriteRule \.(json|bin)$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Never cache index.html so new deploys show up right away
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed JS/CSS files (e.g. main-ABC123.js) can be cached forever
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed assets (CV, images, archives) keep their names across deploys,
  # so browsers must revalidate them to pick up new versions
  <FilesMatch "\.(woff2?|png|jpg|jpeg|svg|webp|ico|pdf|zip)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>
